# ===== Target Platform =====
CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
# Sesuaikan nama profil dari hasil Langkah 3!
CONFIG_TARGET_ath79_generic_DEVICE_liteon_wp8722-bt=y

# ===== WiFi 2.4 GHz (QCA9563 internal, driver ath9k) =====
# ath9k sudah termasuk otomatis di ath79, tidak perlu deklarasi manual.
# Jangan tambahkan ath9k-htc-firmware — itu untuk USB WiFi dongle, bukan untuk ini.

# ===== WiFi 5 GHz (QCA9886, driver ath10k-ct) =====
CONFIG_PACKAGE_kmod-ath10k-ct=y
CONFIG_PACKAGE_ath10k-firmware-qca9886-ct=y

# ===== USB Support =====
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_e2fsprogs=y

# ===== LuCI Web Interface =====
# Di OpenWrt 25.12, luci-app-opkg SUDAH DIGANTI dengan luci-app-package-manager
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_rpcd=y

# ===== PPPoE / WAN =====
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-pppoe=y

# ===== IPv6 =====
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# ===== Utilitas Berguna =====
CONFIG_PACKAGE_wget-ssl=n
CONFIG_PACKAGE_curl=n
CONFIG_PACKAGE_nano=n
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_openssh-sftp-server=y

# ===== Build Log (memudahkan debug jika gagal) =====
CONFIG_BUILD_LOG=y
